{% extends 'layout/base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-slate-950">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
            <div>
                <p class="text-sm uppercase tracking-widest text-slate-500">Analiza statystyczna</p>
                <h1 class="text-2xl font-semibold text-slate-100">Top 20 Kombinacji</h1>
                <p class="mt-1 text-xs text-slate-500">
                    Najczęściej występujące kombinacje 5-elementowe w historii losowań
                </p>
            </div>
            <div class="flex items-center gap-4">
                <a href="/dashboard" class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                    ← Powrót do dashboardu
                </a>
            </div>
        </div>
    </header>

    <main class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-6 py-12">
        <!-- Wykres słupkowy - Top 5 kombinacji w czasie -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
            <h2 class="text-xl font-semibold text-slate-100 mb-4">Występowanie w czasie (Top 5)</h2>
            <p class="text-sm text-slate-400 mb-6">
                Wykres słupkowy przedstawia występowanie 5 najczęstszych kombinacji w podziale na miesiące
            </p>

            {% if chartData.labels is empty %}
                <div class="rounded-xl border border-slate-800 bg-slate-950 p-8 text-center">
                    <p class="text-slate-400">Brak danych do wyświetlenia wykresu</p>
                </div>
            {% else %}
                <div class="relative h-96">
                    <canvas id="monthlyChart"></canvas>
                </div>
            {% endif %}
        </section>

        <!-- Tabela Top 20 -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
            <h2 class="text-xl font-semibold text-slate-100 mb-4">Ranking kombinacji</h2>
            <p class="text-sm text-slate-400 mb-6">
                Lista 20 najczęściej występujących kombinacji posortowana według liczby wystąpień
            </p>

            {% if topCombos is empty %}
                <div class="rounded-xl border border-slate-800 bg-slate-950 p-8 text-center">
                    <p class="text-slate-400">Brak danych w bazie. Wykonaj import przed analizą statystyk.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="border-b border-slate-800 text-xs uppercase text-slate-400">
                            <tr>
                                <th class="px-4 py-3">#</th>
                                <th class="px-4 py-3">Kombinacja</th>
                                <th class="px-4 py-3 text-right">Wystąpienia</th>
                                <th class="px-4 py-3 text-right">Losowania</th>
                                <th class="px-4 py-3">Pierwsze</th>
                                <th class="px-4 py-3">Ostatnie</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for combo in topCombos %}
                            <tr class="border-b border-slate-800/50 transition hover:bg-slate-800/30">
                                <td class="px-4 py-4 font-medium text-slate-300">{{ loop.index }}</td>
                                <td class="px-4 py-4">
                                    <div class="flex gap-2">
                                        {% for number in combo.numbersArray %}
                                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-lime-500 to-lime-600 text-sm font-bold text-slate-900">
                                            {{ number }}
                                        </span>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-right">
                                    <span class="rounded-full bg-lime-400/20 px-3 py-1 text-sm font-semibold text-lime-300">
                                        {{ combo.totalHits }}
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-right text-slate-300">
                                    {{ combo.uniqueDraws }}
                                </td>
                                <td class="px-4 py-4 text-slate-400">
                                    {{ combo.firstDrawDate|date('d.m.Y') }}
                                </td>
                                <td class="px-4 py-4 text-slate-400">
                                    {{ combo.lastDrawDate|date('d.m.Y') }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <!-- Legenda -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
            <h3 class="text-lg font-semibold text-slate-100 mb-4">Wyjaśnienie kolumn</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div>
                    <p class="font-semibold text-lime-400 mb-1">Wystąpienia</p>
                    <p class="text-slate-400">Łączna liczba wystąpień kombinacji we wszystkich losowaniach</p>
                </div>
                <div>
                    <p class="font-semibold text-lime-400 mb-1">Losowania</p>
                    <p class="text-slate-400">Liczba unikalnych losowań, w których kombinacja wystąpiła</p>
                </div>
                <div>
                    <p class="font-semibold text-lime-400 mb-1">Pierwsze / Ostatnie</p>
                    <p class="text-slate-400">Daty pierwszego i ostatniego wystąpienia kombinacji</p>
                </div>
            </div>
        </section>
    </main>
</div>

{% if chartData.labels is not empty %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('monthlyChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ chartData.labels|json_encode|raw }},
            datasets: {{ chartData.datasets|json_encode|raw }}
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: {
                        color: 'rgb(226, 232, 240)',
                        font: {
                            size: 12
                        },
                        padding: 15
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(15, 23, 42, 0.9)',
                    titleColor: 'rgb(226, 232, 240)',
                    bodyColor: 'rgb(203, 213, 225)',
                    borderColor: 'rgb(71, 85, 105)',
                    borderWidth: 1,
                    padding: 12,
                    displayColors: true,
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + context.parsed.y + ' wystąpień';
                        }
                    }
                }
            },
            scales: {
                x: {
                    stacked: false,
                    grid: {
                        color: 'rgba(71, 85, 105, 0.3)',
                        drawBorder: false
                    },
                    ticks: {
                        color: 'rgb(148, 163, 184)',
                        font: {
                            size: 11
                        }
                    }
                },
                y: {
                    stacked: false,
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(71, 85, 105, 0.3)',
                        drawBorder: false
                    },
                    ticks: {
                        color: 'rgb(148, 163, 184)',
                        font: {
                            size: 11
                        }
                    },
                    title: {
                        display: true,
                        text: 'Liczba wystąpień',
                        color: 'rgb(203, 213, 225)',
                        font: {
                            size: 12
                        }
                    }
                }
            }
        }
    });
});
</script>
{% endif %}
{% endblock %}
