{% extends 'layout/base.html.twig' %}

{% block body %}
    <main class="flex min-h-screen items-center justify-center bg-slate-950 px-6 py-16">
        <section class="w-full max-w-xl rounded-2xl border border-slate-800 bg-slate-900/70 p-10 text-center shadow-2xl">
            <h1 class="text-3xl font-semibold tracking-tight text-slate-100">
                Potwierdź swój adres e-mail
            </h1>
            <p class="mt-4 text-sm text-slate-300">
                Wysłaliśmy wiadomość na adres
                <span class="font-semibold text-lime-300">{{ email }}</span>.
                Kliknij link aktywacyjny, aby dokończyć rejestrację.
            </p>

            {% if mailDeliveryFailed %}
                <div class="mt-6 rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-left text-xs text-rose-200">
                    <p class="font-semibold text-rose-200">Nie udało się wysłać wiadomości</p>
                    <p class="mt-2">
                        Poniższy link aktywacyjny możesz skopiować ręcznie, aby dokończyć rejestrację:
                    </p>
                    <a href="{{ verificationLink }}" class="mt-3 block break-all font-mono text-rose-200 hover:text-rose-100">
                        {{ verificationLink }}
                    </a>
                </div>
            {% else %}
                <div class="mt-6 rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-3 text-left text-xs text-slate-400">
                    <p class="font-semibold text-slate-200">Podgląd wiadomości w środowisku lokalnym</p>
                    <p class="mt-2">
                        Wiadomość e-mail znajdziesz w Mailpit (domyślnie <a href="http://localhost:8025" class="text-lime-300 hover:text-lime-200" target="_blank" rel="noopener">http://localhost:8025</a>).
                        Dla wygody link aktywacyjny umieszczamy również poniżej:
                    </p>
                    <a href="{{ verificationLink }}" class="mt-3 block break-all font-mono text-lime-300 hover:text-lime-200">
                        {{ verificationLink }}
                    </a>
                </div>
            {% endif %}

            <div class="mt-10 flex flex-col items-center gap-4 text-sm text-slate-400">
                <p>Nie widzisz wiadomości? Sprawdź folder spam lub poczekaj chwilę.</p>
                <a href="/login" class="rounded-lg bg-lime-400 px-6 py-3 font-semibold text-slate-900 transition hover:bg-lime-300">
                    Przejdź do logowania
                </a>
            </div>
        </section>
    </main>
{% endblock %}
