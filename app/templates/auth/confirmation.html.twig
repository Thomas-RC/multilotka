{% extends 'layout/base.html.twig' %}

{% block body %}
    <main class="flex min-h-screen items-center justify-center bg-slate-950 px-6 py-16">
        <section class="w-full max-w-xl rounded-2xl border border-slate-800 bg-slate-900/70 p-10 text-center shadow-2xl">
            {% if status is defined and status == 'error' %}
                <div class="mb-6 rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
                    {{ message }}
                </div>
                <h1 class="text-3xl font-semibold tracking-tight text-slate-100">
                    Nie udało się potwierdzić konta
                </h1>
                <p class="mt-4 text-sm text-slate-300">
                    Zweryfikuj poprawność linku aktywacyjnego lub rozpocznij proces rejestracji ponownie.
                </p>
                <div class="mt-6 flex justify-center gap-3">
                    <a href="/register" class="rounded-lg border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:border-slate-500">
                        Wróć do rejestracji
                    </a>
                    <a href="/login" class="rounded-lg bg-lime-400 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">
                        Przejdź do logowania
                    </a>
                </div>
            {% else %}
                <h1 class="text-3xl font-semibold tracking-tight text-slate-100">
                    Konto zostało potwierdzone
                </h1>
                <p class="mt-4 text-sm text-slate-300">
                    Możesz już zalogować się do panelu Multilotka.
                </p>
                <a href="/login" class="mt-8 inline-flex rounded-lg bg-lime-400 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">
                    Przejdź do logowania
                </a>
            {% endif %}
        </section>
    </main>
{% endblock %}
