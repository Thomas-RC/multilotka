{% extends 'layout/base.html.twig' %}

{% block body %}
    <div class="flex min-h-screen flex-col">
        <header class="bg-slate-900/80 backdrop-blur">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                <span class="text-lg font-semibold tracking-tight">Multilotka</span>
                <nav class="flex gap-2">
                    <a href="/" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-100 transition hover:bg-slate-800">Start</a>
                    {% if isAuthenticated %}
                        <a href="/dashboard" class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">Dashboard</a>
                        <a href="/logout" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-100 transition hover:bg-slate-800">Wyloguj</a>
                    {% else %}
                        <a href="/login" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-100 transition hover:bg-slate-800">Logowanie</a>
                        <a href="/register" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-100 transition hover:bg-slate-800">Rejestracja</a>
                        <a href="/dashboard" class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">Dashboard</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="mx-auto flex w-full max-w-6xl flex-1 items-center px-6 py-16">
            <div class="grid w-full gap-10 md:grid-cols-2">
                <section>
                    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
                        Analiza losowań Lotto z wykorzystaniem danych historycznych
                    </h1>
                    <p class="mt-6 text-lg text-slate-300">
                        Łączymy statystyki, wizualizacje i modele predykcyjne, aby wspierać strategiczne podejście do losowań Lotto.
                    </p>
                    <div class="mt-8 flex gap-4">
                        <a
                            href="#features"
                            class="rounded-lg bg-lime-400 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-lime-300"
                        >
                            Dowiedz się więcej
                        </a>
                        <a
                            href="#roadmap"
                            class="rounded-lg border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:border-slate-500"
                        >
                            Zobacz plan rozwoju
                        </a>
                    </div>
                </section>

                <aside>
                    <div
                        x-data="{ highlight: 0, items: ['Trend losowań', 'Symulacje strategii', 'Porównania historyczne'] }"
                        class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl"
                    >
                        <p class="text-sm uppercase tracking-widest text-slate-400">
                            Wyróżnione moduły
                        </p>
                        <ul class="mt-4 space-y-3">
                            <template x-for="(item, index) in items" :key="item">
                                <li>
                                    <button
                                        class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-base transition"
                                        :class="highlight === index ? 'bg-lime-400 text-slate-900' : 'bg-slate-800/60 text-slate-200 hover:bg-slate-800'"
                                        @mouseenter="highlight = index"
                                        @focus="highlight = index"
                                    >
                                        <span x-text="item"></span>
                                        <span class="text-xs" x-show="highlight === index">▶</span>
                                    </button>
                                </li>
                            </template>
                        </ul>
                    </div>
                </aside>
            </div>
        </main>

        <footer class="bg-slate-900/80">
            <div class="mx-auto max-w-6xl px-6 py-6 text-sm text-slate-500">
                &copy; {{ "now"|date("Y") }} Multilotka. Wszystkie prawa zastrzeżone.
            </div>
        </footer>
    </div>
{% endblock %}
