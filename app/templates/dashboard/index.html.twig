{% extends 'layout/base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-slate-950">
        <style>
            [x-cloak] {
                display: none !important;
            }
        </style>
        <script>
            document.addEventListener('alpine:init', () => {
                // Store globalny dla statusu importu
                Alpine.store('importStatus', {
                    isActive: {{ (lastImportJob and (lastImportJob.status == 'queued' or lastImportJob.status == 'running')) ? 'true' : 'false' }},
                    updateStatus(job) {
                        this.isActive = job !== null && ['queued', 'running'].includes(job.status);
                    }
                });

                // Komponent kontrolera przycisku "Tipy na dziś"
                Alpine.data('tipButtonController', (hasTipData) => ({
                    hasTipData,
                    canAccessTips() {
                        return this.hasTipData && !this.$store.importStatus.isActive;
                    },
                    getTipButtonTitle() {
                        if (this.$store.importStatus.isActive) {
                            return 'Import w trakcie. Poczekaj na zakończenie importu.';
                        }
                        return 'Brak danych w bazie ClickHouse. Wgraj i przetwórz plik, aby wygenerować tipy.';
                    }
                }));
            });
        </script>
        <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
                <div>
                    <p class="text-sm uppercase tracking-widest text-slate-500">Panel użytkownika</p>
                    <h1 class="text-2xl font-semibold text-slate-100">
                        Witaj ponownie, {{ user ? user.firstName : 'Analityku' }}!
                    </h1>
                    {% if user and user.lastLoginAt %}
                        <p class="mt-1 text-xs text-slate-500">
                            Ostatnie logowanie: {{ user.lastLoginAt|date('d.m.Y H:i') }}
                        </p>
                    {% endif %}
                </div>
                <div class="flex items-center gap-4" x-data="tipButtonController({{ hasTipData ? 'true' : 'false' }})">
                    <a href="/dashboard/stats" class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                        Statystyki
                    </a>
                    <template x-if="canAccessTips()">
                        <a href="/dashboard/tips" class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                            Tipy na dziś
                        </a>
                    </template>
                    <template x-if="!canAccessTips()">
                        <button
                            disabled
                            :title="getTipButtonTitle()"
                            class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-500 cursor-not-allowed opacity-50"
                        >
                            Tipy na dziś
                        </button>
                    </template>
                    <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                        Eksportuj raport
                    </button>
                    <a href="/logout" class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">
                        Wyloguj
                    </a>
                </div>
            </div>
        </header>

        <main class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 py-12">
            {% if errorMessage %}
                <div class="rounded-2xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
                    {{ errorMessage }}
                </div>
            {% endif %}

            {% if flashes %}
                <section class="space-y-3">
                    {% for key, message in flashes %}
                        {% set isSuccess = key starts with 'success' %}
                        {% set content = message is iterable ? message|join(', ') : message %}
                        <div class="rounded-2xl border px-4 py-3 text-sm {{ isSuccess ? 'border-lime-400/40 bg-lime-400/10 text-lime-200' : 'border-rose-500/40 bg-rose-500/10 text-rose-200' }}">
                            {{ content }}
                        </div>
                    {% endfor %}
                </section>
            {% endif %}

            <section id="uploads" class="grid gap-6 lg:grid-cols-2">
                <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                    <p class="text-sm uppercase tracking-widest text-slate-500">Ostatni plik TXT</p>
                    {% if lastUpload %}
                        {% set startDate = lastUpload.drawDateStart ? lastUpload.drawDateStart|date('d.m.Y') : '—' %}
                        {% set endDate = lastUpload.drawDateEnd ? lastUpload.drawDateEnd|date('d.m.Y') : '—' %}
                        <ul class="mt-4 space-y-2 text-sm text-slate-300">
                            <li>
                                <span class="text-slate-500">Nazwa pliku:</span>
                                <span class="font-medium text-slate-100">{{ lastUpload.originalName }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Wgrano:</span>
                                <span>{{ lastUpload.uploadedAt|date('d.m.Y H:i') }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Zakres losowań:</span>
                                <span>{{ startDate }} &rarr; {{ endDate }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Liczba rekordów:</span>
                                <span>{{ lastUpload.rowsTotal }}</span>
                            </li>
                        </ul>
                        <p class="mt-6 text-xs text-slate-500">
                            Każde nowe wgranie zastępuje poprzedni plik i usuwa go z katalogu <code class="rounded bg-slate-800 px-1">storage/uploads</code>.
                        </p>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">
                            Nie wgrano jeszcze żadnego pliku TXT. Skorzystaj z formularza obok, aby rozpocząć import danych.
                        </p>
                    {% endif %}
                </article>

                <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl" x-data="{ activeTab: 'file' }">
                    <h2 class="text-xl font-semibold text-slate-100">Wgraj nowy plik</h2>
                    <p class="mt-2 text-sm text-slate-400">
                        Akceptujemy wyłącznie pliki tekstowe (<code class="rounded bg-slate-800 px-1">*.txt</code>) w formacie:
                        <span class="font-mono text-xs text-slate-300">n. DD.MM.RRRR l1,l2,...,l20</span>.
                    </p>

                    <!-- Tabs -->
                    <div class="mt-4 flex gap-2 border-b border-slate-800">
                        <button
                            @click="activeTab = 'file'"
                            :class="activeTab === 'file' ? 'border-lime-400 text-lime-400' : 'border-transparent text-slate-400 hover:text-slate-300'"
                            class="border-b-2 px-4 py-2 text-sm font-medium transition"
                        >
                            Z komputera
                        </button>
                        <button
                            @click="activeTab = 'url'"
                            :class="activeTab === 'url' ? 'border-lime-400 text-lime-400' : 'border-transparent text-slate-400 hover:text-slate-300'"
                            class="border-b-2 px-4 py-2 text-sm font-medium transition"
                        >
                            Z URL
                        </button>
                    </div>

                    <!-- File Upload Form -->
                    <form method="POST" action="/dashboard/upload" enctype="multipart/form-data" class="mt-6 space-y-4" x-show="activeTab === 'file'" x-cloak>
                        <div>
                            <label for="drawFile" class="text-sm font-medium text-slate-200">Plik losowań</label>
                            <input
                                type="file"
                                id="drawFile"
                                name="drawFile"
                                accept=".txt,text/plain"
                                required
                                class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-lime-400 focus:outline-none focus:ring-1 focus:ring-lime-400"
                            >
                        </div>
                        <button
                            type="submit"
                            class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300"
                        >
                            Wgraj plik
                        </button>
                    </form>

                    <!-- URL Download Form -->
                    <form method="POST" action="/dashboard/upload/from-url" class="mt-6 space-y-4" x-show="activeTab === 'url'" x-cloak>
                        <div>
                            <label for="url" class="text-sm font-medium text-slate-200">Adres URL</label>
                            <input
                                type="url"
                                id="url"
                                name="url"
                                value="http://www.mbnet.com.pl/ml.txt"
                                placeholder="http://www.mbnet.com.pl/ml.txt"
                                required
                                class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-lime-400 focus:outline-none focus:ring-1 focus:ring-lime-400"
                            >
                            <p class="mt-1 text-xs text-slate-500">
                                Domyślnie: oficjalne losowania Multi Multi Lotto
                            </p>
                        </div>
                        <button
                            type="submit"
                            class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300"
                        >
                            Pobierz i wgraj
                        </button>
                    </form>
                </article>
            </section>

{% if lastUpload %}
                <section
                    id="import"
                    class="grid gap-6 lg:grid-cols-2"
                    x-data='importStatusComponent({
                        pollUrl: {{ importStatusUrl|json_encode|raw }},
                        initialJob: {{ lastImportJob ? lastImportJob|json_encode|raw : 'null' }},
                        initialEvents: {{ importEvents|json_encode|raw }},
                        selectedMode: {{ selectedImportMode|json_encode|raw }}
                    })'
                    x-init="init()"
                >
                    <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                        <h2 class="text-xl font-semibold text-slate-100">Uruchom import ETL</h2>
                        <p class="mt-2 text-sm text-slate-400">
                            Wybierz tryb importu dla pliku <span class="font-medium text-slate-100">{{ lastUpload.originalName }}</span>.
                        </p>

                        <form method="POST" action="/dashboard/import" class="mt-6 space-y-4">
                            <input type="hidden" name="file_id" value="{{ lastUpload.id }}">

                            <div class="space-y-2">
                                {% for mode in importModes %}
                                    <label class="flex items-center gap-3 rounded-lg border border-slate-800 bg-slate-900 px-4 py-3 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-200">
                                        <input
                                            type="radio"
                                            name="mode"
                                            value="{{ mode.value }}"
                                            x-model="selectedMode"
                                            class="h-4 w-4 border-slate-600 text-lime-400 focus:ring-lime-400"
                                            required
                                        >
                                        <span>{{ mode.label }}</span>
                                    </label>
                                {% endfor %}
                            </div>

                            <button
                                type="submit"
                                class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300 disabled:cursor-not-allowed disabled:opacity-60"
                                :disabled="isImportActive()"
                            >
                                Uruchom import
                            </button>

                            <p x-show="error" x-text="error" x-cloak class="rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-xs text-rose-200"></p>
                        </form>
                    </article>

                    <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl" x-cloak>
                        <h2 class="text-xl font-semibold text-slate-100">Status ostatniego importu</h2>

                        <template x-if="job">
                            <div>
                                <ul class="mt-4 space-y-2 text-sm text-slate-300">
                                    <li>
                                        <span class="text-slate-500">Tryb:</span>
                                        <span class="font-medium text-slate-100" x-text="job.mode_label"></span>
                                    </li>
                                    <li>
                                        <span class="text-slate-500">Status:</span>
                                        <span class="font-mono text-xs uppercase tracking-widest" :class="job.status_badge_class" x-text="job.status_label"></span>
                                    </li>
                                    <li>
                                        <span class="text-slate-500">Postęp:</span>
                                        <span x-text="job.progress_percent + '%'" class="font-medium text-slate-100"></span>
                                    </li>
                                    <li>
                                        <span class="text-slate-500">Etap:</span>
                                        <span x-text="job.current_stage ? job.current_stage : '—'"></span>
                                    </li>
                                    <li>
                                        <span class="text-slate-500">Start:</span>
                                        <span x-text="job.started_at_human ? job.started_at_human : '—'"></span>
                                    </li>
                                    <li>
                                        <span class="text-slate-500">Zakończenie:</span>
                                        <span x-text="job.finished_at_human ? job.finished_at_human : '—'"></span>
                                    </li>
                                </ul>

                                <div class="mt-4 h-2 w-full rounded-full bg-slate-800">
                                    <div class="h-full rounded-full bg-lime-400 transition-all" :style="`width: ${Math.min(job.progress_percent, 100)}%`"></div>
                                </div>

                                <template x-if="job.error_message">
                                    <p class="mt-4 rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-xs text-rose-200" x-text="job.error_message"></p>
                                </template>

                                <template x-if="events.length > 0">
                                    <div class="mt-6 space-y-3">
                                        <p class="text-xs uppercase tracking-widest text-slate-500">Ostatnie zdarzenia</p>
                                        <ul class="space-y-2 text-xs text-slate-400">
                                            <template x-for="(event, index) in events" :key="index">
                                                <li class="rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-2">
                                                    <div class="flex items-center justify-between">
                                                        <span class="font-mono text-[10px] uppercase tracking-widest text-slate-500" x-text="event.type_label"></span>
                                                        <span class="text-[11px] text-slate-500" x-text="event.created_at_human"></span>
                                                    </div>
                                                    <p class="mt-1 text-slate-300" x-text="event.message"></p>
                                                </li>
                                            </template>
                                        </ul>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <template x-if="!job">
                            <p class="mt-4 text-sm text-slate-400">
                                Nie uruchamiano jeszcze importu dla bieżącego pliku.
                            </p>
                        </template>
                    </article>
                </section>
            {% endif %}

            <section id="activity" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-xl font-semibold text-slate-100">Aktywność modułów</h2>
                        <p class="mt-2 text-sm text-slate-400">
                            Podgląd ostatnich analiz i symulacji.
                        </p>
                    </div>
                    <div class="flex gap-3">
                        <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                            Eksport CSV
                        </button>
                        <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                            Aktualizuj dane
                        </button>
                    </div>
                </div>

                <div class="mt-6 overflow-hidden rounded-xl border border-slate-800">
                    <table class="min-w-full divide-y divide-slate-800 text-left text-sm text-slate-300">
                        <thead class="bg-slate-900/80 text-xs uppercase tracking-widest text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Moduł</th>
                                <th class="px-4 py-3">Opis</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3">Czas</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800 bg-slate-950/60">
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Symulacje losowań</td>
                                <td class="px-4 py-4 text-slate-400">5000 iteracji dla strategii systemowej.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-lime-400/20 px-3 py-1 text-xs font-semibold text-lime-300">
                                        Sukces
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Dziś, 12:45</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Analiza częstotliwości</td>
                                <td class="px-4 py-4 text-slate-400">Porównanie pięciu ostatnich losowań.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-orange-400/20 px-3 py-1 text-xs font-semibold text-orange-300">
                                        W toku
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Dziś, 11:03</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Alerty powiadomień</td>
                                <td class="px-4 py-4 text-slate-400">Konfiguracja alertów SMS dla grupy beta.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-rose-400/20 px-3 py-1 text-xs font-semibold text-rose-300">
                                        Wymaga uwagi
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Wczoraj, 19:22</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
            <script>
                document.addEventListener('alpine:init', () => {
                    Alpine.data('importStatusComponent', ({ pollUrl, initialJob, initialEvents, selectedMode }) => ({
                        pollUrl,
                        job: initialJob,
                        events: Array.isArray(initialEvents) ? initialEvents : [],
                        selectedMode,
                        error: null,
                        timer: null,
                        init() {
                            if (this.shouldPoll()) {
                                void this.startPolling();
                            }
                        },
                        shouldPoll() {
                            return this.job !== null && ['queued', 'running'].includes(this.job.status);
                        },
                        async startPolling() {
                            this.stopPolling();
                            await this.poll(true);
                            if (this.shouldPoll()) {
                                this.timer = setInterval(() => {
                                    void this.poll(false);
                                }, 5000);
                            }
                        },
                        stopPolling() {
                            if (this.timer !== null) {
                                clearInterval(this.timer);
                                this.timer = null;
                            }
                        },
                        async poll(initial = false) {
                            try {
                                const response = await fetch(this.pollUrl, {
                                    headers: { 'Accept': 'application/json' },
                                });
                                const data = await response.json();

                                if (data.error) {
                                    this.error = data.error;
                                    if (!initial) {
                                        this.stopPolling();
                                    }

                                    return;
                                }

                                this.error = null;
                                this.job = data.job;
                                this.events = Array.isArray(data.events) ? data.events : [];

                                // Aktualizuj globalny store statusu importu
                                Alpine.store('importStatus').updateStatus(this.job);

                                if (!this.shouldPoll()) {
                                    this.stopPolling();
                                }
                            } catch (error) {
                                this.error = 'Nie udało się odświeżyć statusu importu.';
                                if (!initial) {
                                    this.stopPolling();
                                }
                            }
                        },
                        isImportActive() {
                            return this.shouldPoll();
                        },
                    }));
                });
            </script>
        </main>
    </div>
{% endblock %}
