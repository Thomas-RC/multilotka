{% extends 'layout/base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-slate-950">
        <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
                <div>
                    <p class="text-sm uppercase tracking-widest text-slate-500">Panel użytkownika</p>
                    <h1 class="text-2xl font-semibold text-slate-100">
                        Witaj ponownie, {{ user ? user.firstName : 'Analityku' }}!
                    </h1>
                    {% if user and user.lastLoginAt %}
                        <p class="mt-1 text-xs text-slate-500">
                            Ostatnie logowanie: {{ user.lastLoginAt|date('d.m.Y H:i') }}
                        </p>
                    {% endif %}
                </div>
                <div class="flex items-center gap-4">
                    <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                        Eksportuj raport
                    </button>
                    <a href="/logout" class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300">
                        Wyloguj
                    </a>
                </div>
            </div>
        </header>

        <main class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 py-12">
            {% if errorMessage %}
                <div class="rounded-2xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
                    {{ errorMessage }}
                </div>
            {% endif %}

            {% if flashes %}
                <section class="space-y-3">
                    {% for key, message in flashes %}
                        {% set isSuccess = key starts with 'success' %}
                        {% set content = message is iterable ? message|join(', ') : message %}
                        <div class="rounded-2xl border px-4 py-3 text-sm {{ isSuccess ? 'border-lime-400/40 bg-lime-400/10 text-lime-200' : 'border-rose-500/40 bg-rose-500/10 text-rose-200' }}">
                            {{ content }}
                        </div>
                    {% endfor %}
                </section>
            {% endif %}

            <section id="uploads" class="grid gap-6 lg:grid-cols-2">
                <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                    <p class="text-sm uppercase tracking-widest text-slate-500">Ostatni plik TXT</p>
                    {% if lastUpload %}
                        {% set startDate = lastUpload.drawDateStart ? lastUpload.drawDateStart|date('d.m.Y') : '—' %}
                        {% set endDate = lastUpload.drawDateEnd ? lastUpload.drawDateEnd|date('d.m.Y') : '—' %}
                        <ul class="mt-4 space-y-2 text-sm text-slate-300">
                            <li>
                                <span class="text-slate-500">Nazwa pliku:</span>
                                <span class="font-medium text-slate-100">{{ lastUpload.originalName }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Wgrano:</span>
                                <span>{{ lastUpload.uploadedAt|date('d.m.Y H:i') }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Zakres losowań:</span>
                                <span>{{ startDate }} &rarr; {{ endDate }}</span>
                            </li>
                            <li>
                                <span class="text-slate-500">Liczba rekordów:</span>
                                <span>{{ lastUpload.rowsTotal }}</span>
                            </li>
                        </ul>
                        <p class="mt-6 text-xs text-slate-500">
                            Każde nowe wgranie zastępuje poprzedni plik i usuwa go z katalogu <code class="rounded bg-slate-800 px-1">storage/uploads</code>.
                        </p>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">
                            Nie wgrano jeszcze żadnego pliku TXT. Skorzystaj z formularza obok, aby rozpocząć import danych.
                        </p>
                    {% endif %}
                </article>

                <article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                    <h2 class="text-xl font-semibold text-slate-100">Wgraj nowy plik</h2>
                    <p class="mt-2 text-sm text-slate-400">
                        Akceptujemy wyłącznie pliki tekstowe (<code class="rounded bg-slate-800 px-1">*.txt</code>) w formacie:
                        <span class="font-mono text-xs text-slate-300">n. DD.MM.RRRR l1,l2,...,l20</span>.
                    </p>

                    <form method="POST" action="/dashboard/upload" enctype="multipart/form-data" class="mt-6 space-y-4">
                        <div>
                            <label for="drawFile" class="text-sm font-medium text-slate-200">Plik losowań</label>
                            <input
                                type="file"
                                id="drawFile"
                                name="drawFile"
                                accept=".txt,text/plain"
                                required
                                class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-lime-400 focus:outline-none focus:ring-1 focus:ring-lime-400"
                            >
                        </div>
                        <button
                            type="submit"
                            class="rounded-lg bg-lime-400 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-lime-300"
                        >
                            Wgraj plik
                        </button>
                    </form>
                </article>
            </section>

            <section id="activity" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
                <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-xl font-semibold text-slate-100">Aktywność modułów</h2>
                        <p class="mt-2 text-sm text-slate-400">
                            Podgląd ostatnich analiz i symulacji.
                        </p>
                    </div>
                    <div class="flex gap-3">
                        <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                            Eksport CSV
                        </button>
                        <button class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 transition hover:border-lime-400 hover:text-lime-300">
                            Aktualizuj dane
                        </button>
                    </div>
                </div>

                <div class="mt-6 overflow-hidden rounded-xl border border-slate-800">
                    <table class="min-w-full divide-y divide-slate-800 text-left text-sm text-slate-300">
                        <thead class="bg-slate-900/80 text-xs uppercase tracking-widest text-slate-500">
                            <tr>
                                <th class="px-4 py-3">Moduł</th>
                                <th class="px-4 py-3">Opis</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3">Czas</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800 bg-slate-950/60">
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Symulacje losowań</td>
                                <td class="px-4 py-4 text-slate-400">5000 iteracji dla strategii systemowej.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-lime-400/20 px-3 py-1 text-xs font-semibold text-lime-300">
                                        Sukces
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Dziś, 12:45</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Analiza częstotliwości</td>
                                <td class="px-4 py-4 text-slate-400">Porównanie pięciu ostatnich losowań.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-orange-400/20 px-3 py-1 text-xs font-semibold text-orange-300">
                                        W toku
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Dziś, 11:03</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-4 font-medium text-slate-200">Alerty powiadomień</td>
                                <td class="px-4 py-4 text-slate-400">Konfiguracja alertów SMS dla grupy beta.</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-rose-400/20 px-3 py-1 text-xs font-semibold text-rose-300">
                                        Wymaga uwagi
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-slate-400">Wczoraj, 19:22</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
